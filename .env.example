# Local development only. Copy to .env; do not use these credentials in production.
POSTGRES_DB=wealth_manager
POSTGRES_USER=wealth_local
POSTGRES_PASSWORD=local_dev_only_change_me
# Loopback by default. For a physical phone, set API_BIND_HOST=0.0.0.0.
API_BIND_HOST=127.0.0.1
API_PORT=8000
# Local development only. Generate a unique value for any shared or deployed environment.
APP_ENV=development
AUTH_SECRET=local_dev_auth_secret_change_me_64_chars_minimum_1234567890abcdef
ACCESS_TOKEN_MINUTES=15
# Maximum private book upload size (20 MiB).
BOOK_MAX_UPLOAD_BYTES=20971520
# Marketplace research import and batch-processing limits.
MARKETPLACE_IMPORT_MAX_BYTES=10485760
MARKETPLACE_IMPORT_MAX_ROWS=10000
MARKETPLACE_BATCH_RANK_MAX=100
# Read-only assistant defaults to local deterministic retrieval with no network calls.
ASSISTANT_PROVIDER=disabled
ASSISTANT_MAX_CONVERSATIONS=20
ASSISTANT_MAX_MESSAGES_PER_CONVERSATION=50
ASSISTANT_RETRIEVAL_LIMIT=8
ASSISTANT_MAX_CONTEXT_CHARS=12000
ASSISTANT_MAX_OUTPUT_CHARS=12000
# Optional external provider. Enabling it sends the question and retrieved evidence externally.
# ASSISTANT_PROVIDER=openai_compatible
# ASSISTANT_PROVIDER_URL=https://provider.example/v1
# ASSISTANT_PROVIDER_MODEL=provider-model-name
# ASSISTANT_PROVIDER_API_KEY=set-in-local-env-only
